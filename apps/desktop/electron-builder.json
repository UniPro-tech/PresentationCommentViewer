{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "jp.uniproject.comeview",
  "asar": true,
  "productName": "PresenComeView",
  "directories": {
    "output": "release/${version}"
  },
  "icon": "public/icon.png",
  "files": ["dist", "dist-electron"],
  "mac": {
    "target": [{ "target": "dmg", "arch": ["arm64"] }],
    "artifactName": "presencomeview-Mac-${version}-Installer.${ext}"
  },
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": ["x64"]
      },
      {
        "target": "msi",
        "arch": ["x64"]
      }
    ],
    "artifactName": "presencomeview-Windows-${version}.${ext}"
  },
  "linux": {
    "target": ["AppImage"],
    "artifactName": "presencomeview-Linux-${version}.${ext}"
  }
}
